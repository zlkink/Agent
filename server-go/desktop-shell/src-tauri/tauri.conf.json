{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RamiCore",
  "version": "0.30.25",
  "identifier": "dev.ramicore.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RamiCore",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https: blob: data:; worker-src 'self' blob:; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "bin": "bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRDk1QzU5NUU1RTBBQUIKUldTckNsNWVXVnpaWUZGb1NmeUlYSDFkdHBDWkxNVXRMZGFnMkdZVDJyZlZGdHQyTUtNVlA1SjcK",
      "endpoints": [
        "https://github.com/zlkink/Agent/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/zlkink/Agent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}