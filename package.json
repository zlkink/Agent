{
  "name": "prometheus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @prometheus/web dev",
    "build:web": "pnpm --filter @prometheus/web build",
    "build:host": "cd server-go && go build ./...",
    "build:plugins": "cd server-go/node/plugin-host && node build-plugins.mjs",
    "build": "pnpm run build:web",
    "typecheck": "pnpm --filter @prometheus/web typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "license": "AGPL-3.0-only"
}
